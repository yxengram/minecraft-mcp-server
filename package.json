{
  "name": "minecraft-mcp-server",
  "version": "3.0.0",
  "description": "MCP server that lets an LLM play Minecraft Java Edition through a Mineflayer bot, with background tasks and an instinct that reacts to danger in real time",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "minecraft",
    "mineflayer",
    "bot",
    "llm",
    "ai-agent"
  ],
  "homepage": "https://github.com/yxengram/minecraft-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/yxengram/minecraft-mcp-server/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yxengram/minecraft-mcp-server.git"
  },
  "license": "Apache-2.0",
  "author": "yxengram",
  "type": "module",
  "main": "dist/main.js",
  "bin": {
    "minecraft-mcp-server": "dist/main.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "npm-shrinkwrap.json"
  ],
  "ava": {
    "files": [
      "tests/**/*.test.ts"
    ],
    "extensions": [
      "ts"
    ],
    "nodeArguments": [
      "--import=tsx"
    ]
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "start": "node dist/main.js",
    "test": "ava",
    "lint": "eslint \"{src,tests}/**/*.ts\"",
    "lint:fix": "eslint \"{src,tests}/**/*.ts\" --fix",
    "test:live": "node scripts/test-live.mjs",
    "test:live:world": "node scripts/test-live-world.mjs",
    "test:scenarios": "node scripts/test-scenarios.mjs",
    "test:smoke": "node scripts/test-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "minecraft-data": "3.117.0",
    "mineflayer": "4.39.0",
    "mineflayer-pathfinder": "2.4.5",
    "vec3": "^0.1.8",
    "yargs": "^18.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@ava/typescript": "^6.0.0",
    "@types/node": "^25.2.3",
    "@types/sinon": "^21.0.0",
    "@types/vec3": "^0.1.4",
    "@types/yargs": "^17.0.35",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.56.1",
    "ava": "^6.4.1",
    "eslint": "^9.39.2",
    "eslint-plugin-ava": "^15.1.0",
    "globals": "^17.3.0",
    "sinon": "^21.0.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
