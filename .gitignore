# Dist folder
dist/

# npm run build:mcpb assembles and packs the MCPB extension here (F-058)
build/

# Node.js dependencies
node_modules/

# Log files
logs/
*.log
npm-debug.log*

# Process IDs
pids/
*.pid
*.seed
*.pid.lock

# NPM cache
.npm/

